<%@ page pageEncoding="UTF-8" %>

<c:url value="/book" var="navBook" />
<c:url value="/profile" var="navProfile" />
<c:url value="/favorites" var="navFavorites" />
<c:url value="/login" var="navLogin" />
<c:url value="/register" var="navRegister" />
<c:url value="/logout" var="navLogout" />

<nav class="navbar">
    <a href="${navBook}">书香校园</a>
    <a href="${navBook}">图书列表</a>

    <c:choose>
        <c:when test="${not empty sessionScope.loginUser}">
            <a href="${navProfile}">个人中心</a>
            <a href="${navFavorites}">我的收藏</a>
            <span>
                <c:out value="${sessionScope.loginUser.nickname}" />
            </span>
            <form action="${navLogout}" method="post">
                <button type="submit">退出</button>
            </form>
        </c:when>
        <c:otherwise>
            <a href="${navLogin}">登录</a>
            <a href="${navRegister}">注册</a>
        </c:otherwise>
    </c:choose>
</nav>