<%@ page pageEncoding="UTF-8" %>
<c:url value="/book" var="navBook" />
<c:url value="/profile" var="navProfile" />
<c:url value="/favorites" var="navFavorites" />
<c:url value="/login" var="navLogin" />
<c:url value="/register" var="navRegister" />
<c:url value="/logout" var="navLogout" />

<header class="site-header">
    <nav class="container navbar" aria-label="主导航">
        <a class="brand" href="${navBook}">
            <span class="brand-mark" aria-hidden="true"></span>
            <span>书香校园</span>
        </a>
        <div class="nav-links">
            <a class="nav-link ${activePage eq 'books' ? 'is-active' : ''}" href="${navBook}">图书列表</a>
            <c:if test="${not empty sessionScope.loginUser}">
                <a class="nav-link ${activePage eq 'favorites' ? 'is-active' : ''}" href="${navFavorites}">我的收藏</a>
                <a class="nav-link ${activePage eq 'profile' ? 'is-active' : ''}" href="${navProfile}">个人中心</a>
            </c:if>
        </div>
        <div class="nav-actions">
            <c:choose>
                <c:when test="${not empty sessionScope.loginUser}">
                    <span class="nav-user"><c:out value="${sessionScope.loginUser.nickname}" /></span>
                    <form action="${navLogout}" method="post">
                        <button class="button button-outline button-small" type="submit">退出</button>
                    </form>
                </c:when>
                <c:otherwise>
                    <a class="nav-link" href="${navLogin}">登录</a>
                    <a class="button button-primary button-small" href="${navRegister}">注册</a>
                </c:otherwise>
            </c:choose>
        </div>
    </nav>
</header>
