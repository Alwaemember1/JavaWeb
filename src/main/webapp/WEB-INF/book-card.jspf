<%@ page pageEncoding="UTF-8" %>
<c:url value="/book/detail" var="detailUrl">
    <c:param name="id" value="${book.id}" />
</c:url>
<article class="book-card">
    <div class="book-art">
        <img src="${pageContext.request.contextPath}/images/covers/${book.id}.jpg" alt=""
             width="480" height="720" loading="${cardStatus.index ge 5 ? 'lazy' : 'eager'}">
    </div>
    <div class="book-content">
        <div class="book-meta">
            <span class="book-category"><c:out value="${book.category}" /></span>
            <c:if test="${book.available}"><span class="status status-available">在架</span></c:if>
            <c:if test="${not book.available}"><span class="status status-borrowed">已借出</span></c:if>
        </div>
        <h3 class="book-title"><c:out value="${book.title}" /></h3>
        <p class="book-author"><c:out value="${book.author}" /></p>
        <p class="book-description"><c:out value="${book.description}" /></p>
        <div class="book-actions">
            <a class="text-link" href="${detailUrl}">查看详情 <span aria-hidden="true">↗</span></a>
            <form action="${navFavorites}" method="post">
                <input type="hidden" name="bookId" value="${book.id}">
                <c:choose>
                    <c:when test="${activePage eq 'favorites'}">
                        <input type="hidden" name="action" value="remove">
                        <button class="button button-outline button-small" type="submit">取消收藏</button>
                    </c:when>
                    <c:otherwise>
                        <button class="button button-outline button-small" type="submit">加入收藏</button>
                    </c:otherwise>
                </c:choose>
            </form>
        </div>
    </div>
</article>
